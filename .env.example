# Copy to .env and fill in. Keep this file out of version control.
TYPESAFE_API_KEY=sk-your-typesafe-key

# Optional: use a local model (e.g. H2O-Lightning-4B in LM Studio) instead of Jev
# TYPESAFE_BASE_URL=http://localhost:1234
# TYPESAFE_DEFAULT_MODEL=h2o-lightning-4b

# Credentials for password login. The config file names these variables.
# APP_USER=your-test-user
# APP_PASSWORD=your-test-password
