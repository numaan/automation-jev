{
  "name": "my-app",
  "url": "https://app.example.com",
  "login": {
    "type": "password",
    "usernameEnv": "APP_USER",
    "passwordEnv": "APP_PASSWORD",
    "loginUrl": "https://app.example.com/login",
    "label": "admin",
    "selectors": {}
  },
  "denyPatterns": ["archive", "cancel.?subscription"],
  "maxScreens": 60,
  "perPattern": 2,
  "settleMs": 8000,
  "linkWaitMs": 4000,
  "expandSelector": "nav [aria-expanded=\"false\"]:not([aria-haspopup])",
  "headless": true
}
